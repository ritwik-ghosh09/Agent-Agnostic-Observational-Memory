{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node scripts/received-context-logger.mjs >> .data/received-context-log/hook.log 2>&1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node scripts/received-context-logger.mjs >> .data/received-context-log/hook.log 2>&1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node scripts/received-context-logger.mjs >> .data/received-context-log/hook.log 2>&1",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
